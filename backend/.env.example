# Copy to .env for local development. In production set these in your host's dashboard.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Leave empty locally (SQLite). Render/Railway set this for Postgres automatically.
DATABASE_URL=
TIME_ZONE=Asia/Bahrain
